{
  "name": "jurisflow-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "playwright": "1.60.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
