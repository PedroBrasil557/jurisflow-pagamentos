{
  "name": "jurisflow-api",
  "scripts": {
    "create:admin": "bun run src/scripts/create-admin.ts",
    "dev": "bun run --hot src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun run scripts/check-migrations.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1012.0",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.5.5",
    "docx-templates": "^4.15.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "latest",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10"
  }
}
