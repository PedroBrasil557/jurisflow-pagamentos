{
  "name": "jurisflow-api",
  "scripts": {
    "create:admin": "bun run src/scripts/create-admin.ts",
    "dev": "bun run --hot src/index.ts",
    "worker": "bun run src/worker.ts",
    "worker:dev": "bun run --hot src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun run scripts/check-migrations.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:test:setup": "bun run scripts/setup-test-db.ts",
    "test:integration": "RUN_INTEGRATION=1 DATABASE_URL=postgresql://postgres:postgres@localhost:3557/app_test bun test src/modules/processes/processes.ingestion.queue.integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1012.0",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.5.5",
    "docx-templates": "^4.15.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "latest",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10"
  }
}
